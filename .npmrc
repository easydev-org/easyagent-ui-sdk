# @easyagent/* lives on GitHub Packages, not npmjs.
#
# THE TOKEN IS NOT HERE. It comes from the environment (`NODE_AUTH_TOKEN`), because a committed
# read:packages token is a token that has to be rotated and has been revoked by secret scanning
# before — which broke every later install in a sibling repository.
#
# Consumers need:
#   @easyagent:registry=https://npm.pkg.github.com
#   //npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
@easyagent:registry=https://npm.pkg.github.com
