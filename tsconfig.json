{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  // THE TESTS ARE EXCLUDED FROM THE BUILD, not from the type check. `tsc -p` here produces the
  // published package, and shipping `sdk.test.js` means every consumer downloads and type-checks
  // vitest's imports for a file that must never run. `check` (--noEmit) still covers them through the
  // separate include below, so the exclusion costs no type safety.
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
